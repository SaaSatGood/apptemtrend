SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
AI_QUOTA_STORE=database
# Opcional, recomendado quando houver mais de uma instância da API.
# REDIS_URL=redis://localhost:6379
# Feed JSON opcional para sincronização automatizada do catálogo.
# CATALOG_FEED_URL=https://example.com/temtrend-products.json
# CATALOG_FEED_TOKEN=your_feed_bearer_token
PORT=3333
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=temtrend-api
# RELEASE=git-sha-or-version
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Opcional: GitHub / CI usa estes valores de exemplo; nunca commitar .env real.
# GEMINI ausente => assistant/content-kit retornam 503 amigável com fallback local.
