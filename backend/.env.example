SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
# Provedor de IA: gemini (padrão) ou openrouter (modelos gratuitos :free).
AI_PROVIDER=gemini
OPENCODE_API_KEY=your_opencode_go_key
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_REASONING_EFFORT=none
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=google/gemma-4-31b-it:free
AI_QUOTA_STORE=database
# Opcional, recomendado quando houver mais de uma instância da API.
# REDIS_URL=redis://localhost:6379
# Feed JSON opcional para sincronização automatizada do catálogo.
# CATALOG_FEED_URL=https://example.com/temtrend-products.json
# CATALOG_FEED_TOKEN=your_feed_bearer_token
# Transacional: OBRIGATÓRIO para o cadastro por código de e-mail.
# Sem a chave, /auth/signup responde 503 e desfaz a conta criada.
# Também alimenta as automações de marketing (série de boas-vindas).
# RESEND_API_KEY=re_sua_chave_aqui
# RESEND_AUDIENCE_ID=id_da_audiencia_general
# Remetente do código de confirmação do cadastro (domínio verificado no Resend).
# EMAIL_FROM=TemTrend <nao-responda@temtrend.com>
# Opcional: webhook Slack/Discord para alertar erros 5xx e falhas de webhook.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# Billing AbacatePay (assinaturas). Sem a flag, tudo opera em modo legado.
# BILLING_ENABLED=false
# ABACATEPAY_API_KEY=sua_chave_de_producao
# ABACATEPAY_WEBHOOK_SECRET=segredo_forte_do_webhook
# ABACATEPAY_API_URL=https://api.abacatepay.com/v2
# IDs de produto têm fallback no código (plans.ts); ver docs/go-live-billing.md.
# ABACATEPAY_PRODUCT_PRO_MENSAL=prod_...
# Billing Asaas (cartão recorrente). O PIX continua no AbacatePay.
# ASAAS_API_KEY=$aact_prod_...
# ASAAS_API_URL=https://api.asaas.com
# ASAAS_WEBHOOK_TOKEN=token_forte_do_webhook_asaas
# URL pública HTTPS de retorno do checkout (localhost é rejeitado pelo Asaas)
# ASAAS_CALLBACK_BASE_URL=https://www.temtrend.com
PORT=3333
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=temtrend-api
# RELEASE=git-sha-or-version
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Opcional: GitHub / CI usa estes valores de exemplo; nunca commitar .env real.
# GEMINI ausente => assistant/content-kit retornam 503 amigável com fallback local.
